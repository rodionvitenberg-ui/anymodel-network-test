# Публичные параметры (не секреты). Секреты дописывает install.sh в deploy/.env
# (файл .env игнорируется git'ом и никогда не коммитится).

# Публичный IPv4 сервера (для клиентской ссылки; IPv6 — просто укажите его)
SERVER_HOST=

# Порт REALITY- inbound'а. Менять не рекомендуется: 443 маскируется под HTTPS.
XRAY_PORT=443

# Сайт-«одолжитель» (dest/SNI для REALITY).
# Требования: TLS 1.3 + HTTP/2, не заблокирован в РФ, крупный и стабильный.
# ИЗБЕГАТЬ (список из исходников Xray-core v26.10.31, infra/conf/transport_security.go):
#   домены .ru/.ir/.cn, а также содержащие 'apple', 'icloud', 'microsoft' — повышенная
#   вероятность блокировки IP (перегретые/поднадзорные цели).
# Хорошие кандидаты: www.samsung.com, www.nvidia.com, www.cisco.com, www.dell.com
# Проверка: openssl s_client -connect ${XRAY_DEST}:443 -tls1_3 -alpn h2 </dev/null
XRAY_DEST=www.samsung.com

# Имя профиля в клиентских приложениях
PROFILE_NAME=anymodel-gw

# Пиннед версия серверного ядра Xray-core: docker-тег ghcr.io/xtls/xray-core
# (тег = версия релиза БЕЗ 'v').
# 26.6.27 — последний релиз, совместимый со ВСЕМИ REALITY-клиентами, включая
# sing-box (ядро Hiddify). 26.7.x отвергает их дефолтным minClientVer=v26.3.27,
# 26.9+ требует пост-квантовый key share X25519MLKEM768. Замеры: docs/adr/0001.
XRAY_VERSION=26.6.27

# Версия ядра для КЛИЕНТСКИХ установок (client/install.sh, client/make-one-shot.sh).
# Отдельно от серверной: клиенту нужен самый новый xray (работает и с 26.6.27,
# и с 26.9+), серверу — самый совместимый. Тег БЕЗ 'v'.
CLIENT_XRAY_VERSION=26.10.31
